{
  "name": "cjl-accounts",
  "productName": "记账本",
  "version": "1.0.0",
  "private": true,
  "description": "个人/家庭日常记账桌面应用，账本数据保存在 Markdown 文件中",
  "author": "cjl",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts",
    "dist": "npm run build && node scripts/dist-win.cjs",
    "dist:win": "npm run dist",
    "dist:android": "npm run build:web && npx cap sync android && node scripts/build-android.cjs",
    "preview": "vite preview --config vite.config.web.ts"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.cjl.accounts",
    "productName": "记账本",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
