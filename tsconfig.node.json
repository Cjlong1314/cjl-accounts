{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "vite.config.web.ts", "capacitor.config.ts", "electron/**/*.ts", "shared/**/*.ts"]
}
